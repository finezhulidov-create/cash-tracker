# Скопируйте в .env и заполните. Файл .env никому не показывайте и не коммитьте.

# Домен, направленный (A-запись) на этот сервер. Caddy сам получит для него HTTPS-сертификат.
DOMAIN=cash.example.com

# Пароль базы данных: openssl rand -hex 24
DB_PASSWORD=

# Секрет подписи JWT, base64-строка от 32 байт: openssl rand -base64 48
# Если его узнают, любой сможет выпускать токены за любого пользователя. При смене все войдут заново.
JWT_SECRET=

# Необязательно: ИИ-советник (GigaChat от Сбера). По умолчанию выключен, остальное приложение работает без него.
# Ключ авторизации берётся в личном кабинете developers.sber.ru (проект GigaChat API → «Получить ключ»).
# Данные о тратах за выбранный месяц (суммы, названия категорий, бюджеты) уходят в Сбер — включайте осознанно.
# GIGACHAT_ENABLED=true
# GIGACHAT_AUTH_KEY=
# Корневые сертификаты Минцифры (Java им не доверяет): положите файлы в deploy/certs/ и укажите пути внутри контейнера
# через запятую (как их скачать — в deploy/README.md, раздел «ИИ-советник»)
# GIGACHAT_CA_CERT_PATH=/certs/russian_trusted_root_ca_pem.crt,/certs/russian_trusted_sub_ca_pem.crt

# Необязательно: другие порты на хосте (если 80/443 заняты другим сервисом)
# HTTP_PORT=80
# HTTPS_PORT=443
# При нестандартном порту (или нескольких адресах сайта) укажите адреса целиком, через запятую,
# иначе бэкенд ответит 403 «Invalid CORS request»: CORS_ORIGINS=https://cash.example.com:8443
# CORS_ORIGINS=

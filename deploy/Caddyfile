# Веб-сервер: раздаёт собранный фронтенд и проксирует API на бэкенд.
# HTTPS-сертификат Caddy получает и продлевает сам (Let's Encrypt), если DOMAIN — настоящий домен,
# направленный на этот сервер. Для проверки по голому HTTP задайте DOMAIN=:80.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Наружу уходят только маршруты API. Swagger, /v3/api-docs и /actuator не проксируются вообще.
	@api path /auth/* /v1/*
	handle @api {
		# Caddy передаёт X-Forwarded-For с реальным адресом клиента (пришедший от клиента заголовок
		# он затирает), а бэкенд берёт его для лимита запросов на /auth (SERVER_FORWARD_HEADERS_STRATEGY=native).
		reverse_proxy app:8080
	}

	handle {
		root * /srv
		# Любой неизвестный путь отдаёт index.html — маршруты SPA (/budgets, /login…) работают при обновлении страницы
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Токен хранится в localStorage, поэтому скрипты разрешены только с нашего домена.
		# style-src 'unsafe-inline' нужен Chakra UI (emotion вставляет стили в страницу).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Хешированные файлы сборки можно кэшировать надолго, index.html — нет
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
}
